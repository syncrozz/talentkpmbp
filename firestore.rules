rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Categories and Skills (Public read)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Students and Student Skills (Read/Write for public application & admin)
    match /students/{studentId} {
      allow read, write: if true;
    }
    
    match /student_skills/{studentSkillId} {
      allow read, write: if true;
    }
    
    // Opportunities and Questions (Public read for active, write for admin)
    match /opportunities/{opportunityId} {
      allow read, write: if true;
    }
    
    match /opportunity_questions/{questionId} {
      allow read, write: if true;
    }
    
    // Applications and Responses
    match /applications/{applicationId} {
      allow read, write: if true;
    }
    
    match /application_responses/{responseId} {
      allow read, write: if true;
    }
    
    match /application_status_history/{historyId} {
      allow read, write: if true;
    }
    
    match /admin_notes/{noteId} {
      allow read, write: if true;
    }
    
    match /invitations/{invitationId} {
      allow read, write: if true;
    }
    
    match /participation_records/{participationId} {
      allow read, write: if true;
    }
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
